# Environment detection script for MikoPBX
# Usage: pbx-env-detect [option]
# Options:
#   -t, --type        Return environment type (docker, vmware, vbox, kvm, qemu, xen, baremetal)
#   -s, --serial      Return serial ports that accept console output
#   --serial-status   Return the state of every serial port, one line per port
#   -c, --console     Return console device
#   -r, --arch        Return CPU architecture (x86_64, aarch64, armv7l, etc)
#   -a, --all         Return all environment information

# Cache file for environment detection
ENV_CACHE="/etc/.pbx_env_info"
ENV_CHECK_AGE=3600  # Re-check every hour

# Serial console state (#1412). The line state changes at runtime, so it is cached
# apart from the environment and only briefly. Flags in SERIAL_DISABLED_DIR are
# written by the writers (SerialConsole.php, pbx-message, the upgrade scripts) for a
# port whose output never drained; such a port stays disabled until reboot.
SERIAL_STATUS_CACHE="/var/run/pbx-serial-status"
SERIAL_STATUS_AGE=60
SERIAL_DISABLED_DIR="/var/run/pbx-serial-disabled"
SERIAL_PROC_DIR="/proc/tty/driver"

# Parse command line options
OPTION="type"
NO_CACHE=0
while [ $# -gt 0 ]; do
    case "$1" in
        -t|--type)
            OPTION="type"
            ;;
        -s|--serial)
            OPTION="serial"
            ;;
        --serial-status)
            OPTION="serial-status"
            ;;
        -c|--console)
            OPTION="console"
            ;;
        -r|--arch)
            OPTION="arch"
            ;;
        -a|--all)
            OPTION="all"
            ;;
        --nocache)
            NO_CACHE=1
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: $0 [-t|--type] [-s|--serial] [--serial-status] [-c|--console] [-r|--arch] [-a|--all] [--nocache]" >&2
            exit 1
            ;;
    esac
    shift
done

# Function to detect a container: prints "docker" or "lxc", nothing otherwise.
# Needs only /bin tools, so the serial port checks can use it at early boot.
detect_container() {
    # Check for Docker
    if [ -f "/.dockerenv" ] || [ -n "$DOCKER_CONTAINER" ]; then
        echo "docker"
        return
    fi

    # Check for LXC via environment variable
    if [ -n "$container" ] && [ "$container" = 'lxc' ]; then
        echo "lxc"
        return
    fi

    # Fallback: check init process environment for LXC
    # Needed when shell doesn't inherit the container env var (e.g., via shell_exec from PHP)
    if [ -r "/proc/1/environ" ]; then
        if grep -qz "container=lxc" /proc/1/environ 2>/dev/null; then
            echo "lxc"
            return
        fi
    fi
}

# Function to detect environment type
detect_environment() {
    local CONTAINER
    CONTAINER=$(detect_container)
    if [ -n "$CONTAINER" ]; then
        echo "$CONTAINER"
        return
    fi

    # Check for virtualization using various methods

    # Method 1: Check DMI/SMBIOS information
    if [ -r "/sys/devices/virtual/dmi/id/sys_vendor" ]; then
        SYS_VENDOR=$(cat /sys/devices/virtual/dmi/id/sys_vendor 2>/dev/null | tr '[:upper:]' '[:lower:]')
        SYS_PRODUCT=$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null | tr '[:upper:]' '[:lower:]')

        case "$SYS_VENDOR" in
            *vmware*)
                echo "vmware"
                return
                ;;
            *innotek*|*virtualbox*)
                echo "vbox"
                return
                ;;
            *qemu*)
                # Distinguish between QEMU and KVM
                if grep -q "kvm" /proc/cpuinfo 2>/dev/null || [ -e "/dev/kvm" ]; then
                    echo "kvm"
                else
                    echo "qemu"
                fi
                return
                ;;
            *xen*)
                echo "xen"
                return
                ;;
        esac

        # Check product name for QEMU
        case "$SYS_PRODUCT" in
            *qemu*)
                if grep -q "kvm" /proc/cpuinfo 2>/dev/null || [ -e "/dev/kvm" ]; then
                    echo "kvm"
                else
                    echo "qemu"
                fi
                return
                ;;
        esac
    fi
    
    # Method 2: Check for hypervisor
    if [ -r "/sys/hypervisor/type" ]; then
        HYPERVISOR=$(cat /sys/hypervisor/type 2>/dev/null | tr '[:upper:]' '[:lower:]')
        case "$HYPERVISOR" in
            xen)
                echo "xen"
                return
                ;;
        esac
    fi
    
    # Method 3: Check CPU flags for virtualization
    if [ -r "/proc/cpuinfo" ]; then
        if grep -q "hypervisor" /proc/cpuinfo 2>/dev/null; then
            # Try to determine if it's QEMU by checking model name
            MODEL_NAME=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -n1 | tr '[:upper:]' '[:lower:]')
            case "$MODEL_NAME" in
                *qemu*)
                    if grep -q "kvm" /proc/cpuinfo 2>/dev/null || [ -e "/dev/kvm" ]; then
                        echo "kvm"
                    else
                        echo "qemu"
                    fi
                    return
                    ;;
            esac
            # We're virtualized, but couldn't determine the type
            echo "virtual"
            return
        fi
    fi
    
    # Method 4: Check for specific files/directories
    if [ -d "/proc/xen" ]; then
        echo "xen"
        return
    fi
    
    # Method 5: Check loaded modules
    if [ -r "/proc/modules" ]; then
        if grep -q "vboxguest" /proc/modules 2>/dev/null; then
            echo "vbox"
            return
        fi
        if grep -q "vmw_balloon" /proc/modules 2>/dev/null; then
            echo "vmware"
            return
        fi
    fi

    # Method 6: Check dmesg for DMI info (useful during early boot when sysfs may not be ready)
    DMESG_DMI=$(/bin/dmesg 2>/dev/null | /bin/grep -i "DMI:" | head -n1 | tr '[:upper:]' '[:lower:]')
    if [ -n "$DMESG_DMI" ]; then
        case "$DMESG_DMI" in
            *qemu*)
                if [ -e "/dev/kvm" ]; then
                    echo "kvm"
                else
                    echo "qemu"
                fi
                return
                ;;
            *vmware*)
                echo "vmware"
                return
                ;;
            *virtualbox*)
                echo "vbox"
                return
                ;;
        esac
    fi

    # If we get here, assume bare metal
    echo "baremetal"
}

# Function to detect CPU architecture
detect_architecture() {
    # Method 1: Use uname -m (most reliable)
    if command -v uname >/dev/null 2>&1; then
        ARCH=$(uname -m 2>/dev/null)
        if [ -n "$ARCH" ]; then
            echo "$ARCH"
            return
        fi
    fi

    # Method 2: Check /proc/cpuinfo
    if [ -r "/proc/cpuinfo" ]; then
        # For ARM systems, check CPU architecture field
        CPU_ARCH=$(grep "CPU architecture" /proc/cpuinfo 2>/dev/null | head -n1 | awk '{print $3}')
        if [ -n "$CPU_ARCH" ]; then
            case "$CPU_ARCH" in
                8)
                    echo "aarch64"
                    return
                    ;;
                7)
                    echo "armv7l"
                    return
                    ;;
                6)
                    echo "armv6l"
                    return
                    ;;
            esac
        fi

        # For x86 systems, check flags
        if grep -q "lm" /proc/cpuinfo 2>/dev/null; then
            echo "x86_64"
            return
        elif grep -q "flags" /proc/cpuinfo 2>/dev/null; then
            echo "i686"
            return
        fi
    fi

    # Method 3: Check for architecture-specific files
    if [ -d "/lib64" ] || [ -d "/usr/lib64" ]; then
        echo "x86_64"
        return
    fi

    # Fallback
    echo "unknown"
}

# serial_candidates: print "DEVICE UART" for every serial port backed by hardware.
serial_candidates() {
    local DEV serialInfo uart SETSERIAL

    # Detect x86 (ttyS*) ports via setserial. NEVER open the device directly
    # (e.g. `printf > /dev/ttyS0`): a blocking open() hangs FOREVER waiting for
    # carrier (DCD) when CLOCAL is unset — common on VPS/QEMU where /dev/ttyS0
    # exists and is writable but has no live UART. Such hung opens pile up as
    # unkillable processes and starve the scheduler. busybox setserial opens with
    # O_NONBLOCK, so it never blocks; this mirrors the boot-time scan in /init.
    SETSERIAL="setserial"
    command -v setserial >/dev/null 2>&1 || SETSERIAL="busybox setserial"
    for DEV in /dev/ttyS0 /dev/ttyS1 /dev/ttyS2 /dev/ttyS3 /dev/ttyS4 /dev/ttyS5; do
        [ -c "$DEV" ] || continue
        serialInfo=$($SETSERIAL -g "$DEV" 2>/dev/null)
        # Skip absent ports (empty output) and phantom ones (uart:unknown)
        [ -z "$serialInfo" ] && continue
        case "$serialInfo" in
            *unknown*) continue ;;
        esac
        uart=$(echo "$serialInfo" | sed -n 's/.*UART: *\([^,]*\).*/\1/p')
        echo "$DEV ${uart:-8250}"
    done

    # ARM (ttyAMA*) ports: setserial does not apply (PL011 is not an 8250 UART).
    # Still filter phantom/unbound ports — the write-probe added in 54eec5ef0
    # (fix false-positive serial detection) was intentional — but do it WITHOUT
    # opening the device, since a blocking open() can hang exactly like ttyS.
    # A real PL011 is bound to a hardware device exposed at
    # /sys/class/tty/<name>/device; absent/phantom ports lack it.
    for DEV in /dev/ttyAMA0 /dev/ttyAMA1 /dev/ttyAMA2 /dev/ttyAMA3; do
        [ -c "$DEV" ] || continue
        [ -e "/sys/class/tty/${DEV#/dev/}/device" ] || continue
        echo "$DEV PL011"
    done
}

# serial_port_status: print one status line for a serial port:
#   DEVICE STATE uart=.. tx=.. signals=.. crtscts=.. clocal=.. reason=free text
# STATE is "ok" (output can leave the port), "blocked" (the line state stops
# output right now) or "disabled" (a writer gave up on it until reboot).
# Only the driver's line state and termios are read; nothing is written to the
# port. Whether anybody listens on the other end cannot be told reliably.
# Args: $1 device, $2 UART type
serial_port_status() {
    local dev="$1" uart="$2" name drv idx line tx sig modes crtscts clocal state reason
    name="${dev##*/}"
    case "$name" in
        ttyS*) drv="serial"; idx="${name#ttyS}" ;;
        *) drv="ttyAMA"; idx="${name#ttyAMA}" ;;
    esac

    # /proc/tty/driver/<drv>: "0: uart:16550A port:000003F8 irq:4 tx:123 rx:0 RTS|CTS|DTR|DSR|CD"
    line=$(grep "^${idx}:" "$SERIAL_PROC_DIR/$drv" 2>/dev/null)
    tx=$(echo "$line" | sed -n 's/.* tx:\([0-9]*\).*/\1/p')
    sig="${line##* }"
    case "$sig" in
        *[!A-Z\|]*|'') sig="" ;;
    esac

    # termios matters only when CTS or CD is missing. stty only reads here and opens
    # the port with O_NONBLOCK; the timeout (SIGKILL) is a safety net.
    crtscts="-"
    clocal="-"
    case "|$sig|" in
        *"|CTS|"*"|CD|"*|*"|CD|"*"|CTS|"*) ;;
        *)
            modes=$(/bin/busybox timeout -s KILL 2 stty -F "$dev" -a 2>/dev/null)
            case " $(echo $modes) " in
                *" -crtscts "*) crtscts=0 ;;
                *" crtscts "*) crtscts=1 ;;
            esac
            case " $(echo $modes) " in
                *" -clocal "*) clocal=0 ;;
                *" clocal "*) clocal=1 ;;
            esac
            ;;
    esac

    state="ok"
    reason="-"
    if [ -e "$SERIAL_DISABLED_DIR/$name" ]; then
        state="disabled"
        reason=$(sed -n 's/^reason=//p' "$SERIAL_DISABLED_DIR/$name" 2>/dev/null)
        reason="${reason:-unknown}, until reboot"
    elif [ "$crtscts" = "1" ] && ! serial_has_signal "$sig" CTS; then
        state="blocked"
        reason="hardware flow control (crtscts) is on and CTS is not asserted"
    elif [ "$clocal" = "0" ] && ! serial_has_signal "$sig" CD; then
        state="blocked"
        reason="clocal is off and there is no carrier (CD): open() would wait for it"
    fi
    [ "$state" = "blocked" ] && serial_log_blocked_once "$dev" "$reason"

    echo "$dev $state uart=$uart tx=${tx:--} signals=${sig:--} crtscts=$crtscts clocal=$clocal reason=$reason"
}

# serial_has_signal: true when the modem signal $2 is in the "|"-list $1
serial_has_signal() {
    case "|$1|" in
        *"|$2|"*) return 0 ;;
    esac
    return 1
}

# serial_log_blocked_once: log a blocked port once per boot. The state is checked
# again on every cache refresh, and a line that stays blocked must not repeat it.
serial_log_blocked_once() {
    /bin/busybox mkdir -p "$SERIAL_DISABLED_DIR" 2>/dev/null
    if ( set -C; : > "$SERIAL_DISABLED_DIR/.blocked-${1##*/}" ) 2>/dev/null; then
        /bin/busybox logger -t pbx-serial -p daemon.warning \
            "Serial console $1 not used: $2. Run pbx-serial-check for details." 2>/dev/null
    fi
}

# serial_status: status lines of every serial port, cached for SERIAL_STATUS_AGE
serial_status() {
    local out tmp
    if [ "$NO_CACHE" -eq 0 ] && [ -f "$SERIAL_STATUS_CACHE" ]; then
        CACHE_AGE=$(($(date +%s) - $(/bin/busybox stat -c %Y "$SERIAL_STATUS_CACHE" 2>/dev/null || echo 0)))
        if [ "$CACHE_AGE" -lt "$SERIAL_STATUS_AGE" ]; then
            cat "$SERIAL_STATUS_CACHE"
            return
        fi
    fi

    # Containers have no serial console of their own
    if [ -n "$(detect_container)" ]; then
        out=""
    else
        out=$(serial_candidates | while read -r dev uart; do serial_port_status "$dev" "$uart"; done)
    fi

    if [ "$NO_CACHE" -eq 0 ]; then
        tmp="$SERIAL_STATUS_CACHE.$$"
        { printf '%s' "${out:+$out
}" > "$tmp" && mv -f "$tmp" "$SERIAL_STATUS_CACHE"; } 2>/dev/null || rm -f "$tmp" 2>/dev/null
    fi
    [ -n "$out" ] && echo "$out"
}

# serial_ports: devices of the ports that accept console output, space-separated.
# Shell builtins only: pbx-message calls this at early boot, before /usr (awk) is mounted.
serial_ports() {
    local dev state rest ports=""
    serial_status | while read -r dev state rest; do
        [ "$state" = "ok" ] && printf '%s ' "$dev"
    done | { read -r ports; echo "$ports"; }
}

# Function to detect console device
detect_console() {
    # Default console
    CONSOLE="/dev/console"
    
    # Check if we have a proper console
    if [ -c "$CONSOLE" ] && [ -r "$CONSOLE" ] && [ -w "$CONSOLE" ]; then
        echo "$CONSOLE"
    else
        # Fallback to null device
        echo "/dev/null"
    fi
}

# Function to get cached or fresh environment info
get_env_info() {
    # Check if cache exists and is recent (skip if --nocache)
    if [ "$NO_CACHE" -eq 0 ] && [ -f "$ENV_CACHE" ]; then
        CACHE_AGE=$(($(date +%s) - $(/bin/busybox stat -c %Y "$ENV_CACHE" 2>/dev/null || echo 0)))
        if [ "$CACHE_AGE" -lt "$ENV_CHECK_AGE" ]; then
            cat "$ENV_CACHE"
            return
        fi
    fi

    # Generate fresh environment info
    ENV_TYPE=$(detect_environment)
    CONSOLE=$(detect_console)
    ARCH=$(detect_architecture)

    # Save to cache (skip if --nocache)
    if [ "$NO_CACHE" -eq 0 ] && [ -n "$ENV_TYPE" ]; then
        cat > "$ENV_CACHE" << EOF
ENV_TYPE=$ENV_TYPE
CONSOLE=$CONSOLE
ARCH=$ARCH
EOF
    fi

    # Return current values
    cat << EOF
ENV_TYPE=$ENV_TYPE
CONSOLE=$CONSOLE
ARCH=$ARCH
EOF
}

# Main execution
case "$OPTION" in
    type)
        get_env_info | grep "^ENV_TYPE=" | cut -d'=' -f2
        ;;
    serial)
        serial_ports
        ;;
    serial-status)
        serial_status
        ;;
    console)
        get_env_info | grep "^CONSOLE=" | cut -d'=' -f2
        ;;
    arch)
        get_env_info | grep "^ARCH=" | cut -d'=' -f2
        ;;
    all)
        get_env_info
        echo "SERIAL_PORTS=$(serial_ports)"
        ;;
esac

exit 0