# KILL will IGNORE this PID
export MAIN_PID="$$";

/sbin/freestorage
/sbin/freeupoffload

# RAID
mdadmPath=$(/sbin/which mdadm)
if [ -n "$mdadmPath" ]; then
  # Stop any running RAID arrays
  "$mdadmPath" --detail --scan 2>/dev/null | /bin/busybox cut -d ' ' -f 2 | /bin/xargs "$mdadmPath" --stop >/dev/null 2>/dev/null
fi
# RAID END

if [ -f /tmp/ejectcd ]; then
  # Eject the drive the system was actually booted from. The kernel lists CD
  # drives in reverse order in dev.cdrom.info, so its first name is not
  # necessarily the one holding the installation ISO (sr1 with sr0 present).
  cddev=$(/bin/busybox awk '$2 == "/offload" {print $1}' /proc/mounts | /bin/busybox head -n 1)
  case "$cddev" in
    /dev/sr*|/dev/cdrom) ;;
    *) cddev="" ;;
  esac
  if [ -z "$cddev" ]; then
    cddev=$(/bin/lsblk -d -r -o NAME,TYPE -n | /bin/busybox grep "rom$" | /bin/busybox cut -d ' ' -f 1 | /bin/busybox sed 's|^|/dev/|')
  fi
  for dev in $cddev; do
    echo "Eject CD from drive ${dev}..."
    /bin/busybox eject "$dev" >/dev/null 2>/dev/null
    /bin/busybox eject -s "$dev" >/dev/null 2>/dev/null
  done
else
  sleep 3
fi

/sbin/reboot
