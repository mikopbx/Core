{
  "includeCoAuthoredBy": false,
  "hooks": {
    "UserPromptSubmit": [],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-review.js"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-translations.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/post-commit-cleanup.js"
          }
        ]
      }
    ],
    "SessionStart": []
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(/vendor/**)",
      "Read(/**/node_modules/**)",
      "Read(/build/**)",
      "Read(/sites/admin-cabinet/assets/js/pbx/**)",
      "Read(/sites/admin-cabinet/assets/js/vendor/**)",
      "Read(/**/*.min.js)",
      "Read(/**/*.min.css)",
      "Read(/resources/db/**)",
      "Read(/resources/sounds-base/**)",
      "Read(/resources/rootfs/**)",
      "Read(/.claude/.backup-*/**)",
      "Read(/tests/AdminCabinet/reports/**)",
      "Read(/.hypothesis/**)"
    ]
  }
}
